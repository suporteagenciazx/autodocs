# AutoDocs Docker — copie para .env e ajuste as passwords
# cp .env.example .env

# Porta HTTP local do app (8080 costuma estar ocupada; 8088 é alternativa segura)
APP_PORT=8088

# MySQL (serviço "db" no compose)
MYSQL_DATABASE=autodocs
MYSQL_USER=autodocs_app
MYSQL_PASSWORD=autodocs_local_change_me
MYSQL_ROOT_PASSWORD=autodocs_root_change_me

# Redis (prefixo das chaves de cache)
AUTODOCS_REDIS_PREFIX=autodocs:

# Cookie de sessão Secure (0 = HTTP local; 1 = HTTPS na VPS)
AUTODOCS_SESSION_COOKIE_SECURE=0

# Permitir auto-registo público (0/1)
AUTODOCS_REGISTRATION_OPEN=0

# Token pessoal Figma (Settings → Security → Personal access tokens)
# Usado na importação Designer → Figma
AUTODOCS_FIGMA_TOKEN=

# --- Import da BD XAMPP → Docker (scripts/docker-import-xampp-db.ps1) ---
# No XAMPP local root costuma ser sem password; ajuste se necessário.
XAMPP_MYSQL_BIN=C:\xampp\mysql\bin
XAMPP_MYSQL_HOST=127.0.0.1
XAMPP_MYSQL_PORT=3306
XAMPP_MYSQL_USER=root
XAMPP_MYSQL_PASSWORD=
XAMPP_MYSQL_DATABASE=autodocs
